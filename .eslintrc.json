{
	"root": true,
	"env": {
		"es6": true,
		"node": true,
		"mocha": true
	},
	"extends": [
		"eslint:recommended"
	],
	"overrides": [
		{
			"files": ["admin/**/*.js", "admin/**/*.jsx"],
			"env": { "browser": true, "node": false, "mocha": false }
		},
		{
			"files": ["admin/index_m.js"],
			"globals": { "$": "readonly", "M": "readonly", "socket": "readonly", "_": "readonly" }
		},
		{
			"files": ["admin/words.js"],
			"rules": { "indent": ["error", 2] }
		},
		{
			"files": ["admin/src/**/*.jsx"],
			"extends": ["plugin:react/recommended"],
			"parserOptions": { "sourceType": "module" },
			"settings": { "react": { "version": "detect" } },
			"globals": { "require": "readonly" }
		}
	],
	"rules": {
		"indent": [
			"error",
			"tab",
			{
				"SwitchCase": 1
			}
		],
		"no-console": "off",
		"no-var": "error",
		"no-trailing-spaces": "error",
		"prefer-const": "error",
		"quotes": [
			"error",
			"double",
			{
				"avoidEscape": true,
				"allowTemplateLiterals": true
			}
		],
		"semi": [
			"error",
			"always"
		]
	},
	"parserOptions": {
		"ecmaVersion": 2018,
		"ecmaFeatures": {
			"jsx": true
		}
	}
}
